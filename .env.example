# Copy this file to .env and fill in real values before running.
# Never commit your actual .env file to git.

# Long random string used to sign login sessions (JWTs).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# How long a login session stays valid.
JWT_EXPIRES_IN=7d

# Port the server listens on.
PORT=3001

# Comma-separated list of origins allowed to call this API from a browser.
# Add your frontend's real domain when you deploy.
CORS_ORIGIN=http://localhost:3001,http://localhost:5173

# Optional: lets the site send an email when someone gets a new message.
# If you leave these blank, the site still works fine - it just skips sending
# emails and prints a note to the terminal instead.
#
# Example values for a Gmail account (you'll need an "app password", not your
# regular Gmail password - search "Google app passwords" to set one up):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASS=your16digitapppassword
#   SMTP_FROM=youraddress@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Only needed when deploying to a host like Railway/Render: point this at a
# persistent volume's mount path (e.g. /data) so your database and uploaded
# photos survive redeploys. Leave blank for local development - it defaults
# to a folder inside the project.
DATA_DIR=

# Contractor subscription billing (Stripe). Leave all blank to develop without
# payments - the site still works, contractors just can't subscribe or claim
# jobs (claiming requires an active subscription).
#
# Setup:
#  1. Create a free Stripe account at stripe.com (test mode needs no real business info).
#  2. Dashboard > Developers > API keys: copy the "Secret key" into STRIPE_SECRET_KEY.
#  3. Dashboard > Product catalog: create a Product with a recurring monthly Price.
#     Copy that Price's ID (starts with "price_") into STRIPE_PRICE_ID.
#  4. For local testing, install the Stripe CLI and run:
#       stripe listen --forward-to localhost:3001/api/billing/webhook
#     It will print a webhook signing secret (starts with "whsec_") - put that
#     in STRIPE_WEBHOOK_SECRET. In production, create a webhook endpoint in the
#     Stripe Dashboard instead, pointed at https://yourdomain.com/api/billing/webhook,
#     and use the signing secret it gives you.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Your site's real public URL once deployed (e.g. https://tradelink.up.railway.app).
# Used to build Stripe checkout redirect links. Leave blank for local testing -
# it falls back to whatever host the request came in on.
APP_URL=
